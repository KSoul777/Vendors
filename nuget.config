<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scope package restore for this solution to the public nuget.org feed only.
    <clear /> drops any feeds inherited from machine/user-level nuget.config
    (e.g. a private company feed), which keeps central package management happy.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
